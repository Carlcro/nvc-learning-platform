# =============================================================================
# Web build and browser runtime
# =============================================================================
# Copy this file to .env.local for local development. Only VITE_ prefixed
# variables reach the browser, so never put a secret behind that prefix.

# The Convex deployment the frontend talks to. Required: the app throws at
# startup if it is missing, rather than booting into a broken state.
# `npx convex dev` writes this into .env.local for you.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Which Convex deployment the CLI acts on. Written by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# =============================================================================
# Set on the Convex deployment, NOT in this file
# =============================================================================
# These live on the backend and must be set per deployment (dev and prod hold
# separate values). Set them with:
#   npx convex env set NAME value
#   npx convex env set NAME value --prod
# List what is currently set with `npx convex env list`.

# Claude API key, used by the Convex Node actions that run roleplay,
# scoring, and daily challenge generation. Required for practice to work.
#   ANTHROPIC_API_KEY=sk-ant-...

# GitHub OAuth credentials, for the GitHub sign-in button.
#   AUTH_GITHUB_ID=...
#   AUTH_GITHUB_SECRET=...

# Resend, used to email the password reset code. Without both of these set,
# the reset flow fails and a forgotten password means a locked-out account.
# The from address has to be on a domain verified in Resend; until one is,
# Resend only delivers to the address that owns the account.
#   RESEND_API_KEY=re_...
#   AUTH_EMAIL_FROM="NVC Learning App <noreply@your-domain>"

# Auth token signing. `node scripts/generate-key.mjs` produces both values.
#   JWT_PRIVATE_KEY=...
#   JWKS=...

# The origin the deployed frontend is served from, used for auth redirects.
# Local development: http://localhost:3000
# Production: the real site origin.
#   SITE_URL=https://your-site-origin

# CONVEX_SITE_URL is set automatically by Convex and read in
# convex/auth.config.ts. You do not set it yourself.
