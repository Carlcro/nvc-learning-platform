# Convex Configuration
# Get these values from: npx convex deploy
# or from the Convex dashboard (https://dashboard.convex.dev)
CONVEX_URL=https://your-deployment-name.convex.cloud

# Optional: Only needed if Convex API key authentication is required
# CONVEX_API_KEY=your-api-key-here

# Development vs Production
NODE_ENV=development

# Optional: Claude/Anthropic API Key (for Convex serverless functions)
# Store this securely - never commit to git
# ANTHROPIC_API_KEY=sk-...

# Optional: OpenAI API Key (if used in functions)
# OPENAI_API_KEY=sk-...
